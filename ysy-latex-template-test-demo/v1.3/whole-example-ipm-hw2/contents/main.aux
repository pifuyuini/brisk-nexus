\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces 系统采用稳定的激光光源（如氦氖激光器）发出光束，经过准直透镜形成平行准直光。准直光经分光镜反射后射向被测目标反射镜。目标反射镜将光束沿原路径反射回自准直光路，反射光束再次通过分光镜并进入聚焦透镜，被聚焦至焦平面上。焦平面上的光斑位移通过机械联动装置转化为旋转运动，该旋转量由高分辨率旋转增量式光学编码器测量，信号处理单元对编码器输出进行解析，从而实现角度变化的高精度测量与数字化输出。\relax }}{4}{figure.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:ipmhw2schematic}{{1}{4}{系统采用稳定的激光光源（如氦氖激光器）发出光束，经过准直透镜形成平行准直光。准直光经分光镜反射后射向被测目标反射镜。目标反射镜将光束沿原路径反射回自准直光路，反射光束再次通过分光镜并进入聚焦透镜，被聚焦至焦平面上。焦平面上的光斑位移通过机械联动装置转化为旋转运动，该旋转量由高分辨率旋转增量式光学编码器测量，信号处理单元对编码器输出进行解析，从而实现角度变化的高精度测量与数字化输出。\relax }{figure.caption.2}{}}
\newlabel{fig:ipmhw2schematic@cref}{{[figure][1][]1}{[1][3][]4}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}数学模型与公式推导}{5}{subsection.3.2}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {4}装置设计、零部件与参数选型}{6}{section.4}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.1}装置设计}{6}{subsection.4.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces 激光光源经准直透镜形成平行光，入射至分光镜，并被引导至目标反射镜。反射光束经分光镜透射进入聚焦透镜系统，在焦平面形成光斑。该光斑位移经机械联动机构放大并传递至旋转编码器。编码器将角度变化转换为数字信号，传送至信号处理模块进行解析。图中标注了各模块在系统中的实际布局与功能分区，体现了自准直测量链路与数字量采集之间的集成结构。\relax }}{7}{figure.caption.3}\protected@file@percent }
\newlabel{fig:pmhw2detaileddesign}{{2}{7}{激光光源经准直透镜形成平行光，入射至分光镜，并被引导至目标反射镜。反射光束经分光镜透射进入聚焦透镜系统，在焦平面形成光斑。该光斑位移经机械联动机构放大并传递至旋转编码器。编码器将角度变化转换为数字信号，传送至信号处理模块进行解析。图中标注了各模块在系统中的实际布局与功能分区，体现了自准直测量链路与数字量采集之间的集成结构。\relax }{figure.caption.3}{}}
\newlabel{fig:pmhw2detaileddesign@cref}{{[figure][2][]2}{[1][6][]7}}
